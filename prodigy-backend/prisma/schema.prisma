// Tells Prisma which database we're using and where the client goes
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users (Applicants) ───────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  phone     String

  // Extended profile fields (collected during application)
  gender              String?
  collegeName         String?
  highestQualification String?
  passingYear         String?
  country             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applications Application[]
  certificates Certificate[]

  @@index([email])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

// ─── Internship Tracks ────────────────────────────────────────────────────────
model Track {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  code         String   @unique // Short code e.g. WD, ML, DS
  description  String?
  curriculum   Json?
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  batches      Batch[]
  applications Application[]
  certificates Certificate[]

  @@index([slug])
  @@map("tracks")
}

// ─── Batches ──────────────────────────────────────────────────────────────────
model Batch {
  id           String      @id @default(uuid())
  trackId      String
  startDate    DateTime
  endDate      DateTime
  status       BatchStatus @default(OPEN)
  capacity     Int         @default(100)
  currentCount Int         @default(0)
  createdAt    DateTime    @default(now())

  // Relations
  track        Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([trackId])
  @@index([startDate])
  @@index([status])
  @@map("batches")
}

// ─── Applications ─────────────────────────────────────────────────────────────
model Application {
  id      String @id @default(uuid())
  userId  String
  trackId String
  batchId String?

  // Payment (kept for backwards compatibility — now managed via TaskSubmission)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentAmount  Int           @default(0) // ₹0 — payment moved to task submission
  paymentId      String?
  paymentOrderId String?
  paidAt         DateTime?

  // Workflow
  offerLetterSentAt  DateTime?
  taskFormSentAt     DateTime?
  taskSubmittedAt    DateTime?
  taskSubmissionData Json?

  // Social confirmation at application time
  joinedSocials Boolean @default(false)

  // Metadata
  applicationMonth DateTime
  status           ApplicationStatus @default(SUBMITTED)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track          Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  batch          Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  certificate    Certificate?
  taskSubmission TaskSubmission?

  // One application per user per month
  @@unique([userId, applicationMonth])
  @@index([userId])
  @@index([batchId])
  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("applications")
}

// ─── Certificates ─────────────────────────────────────────────────────────────
model Certificate {
  id            String   @id @default(uuid())
  cin           String   @unique // e.g., PIT/JAN26/00820
  applicationId String   @unique
  userId        String
  trackId       String

  issuedDate      DateTime
  isActivated     Boolean  @default(false)
  certificateUrl  String?

  verifiedCount  Int       @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([cin])
  @@index([userId])
  @@index([issuedDate(sort: Desc)])
  @@map("certificates")
}

// ─── Task Submissions ─────────────────────────────────────────────────────────
model TaskSubmission {
  id            String   @id @default(uuid())
  applicationId String   @unique
  userId        String

  // Task links (at least 2 required for certificate, 4 for LoR)
  task1GithubUrl    String?
  task1LinkedinUrl  String?
  task2GithubUrl    String?
  task2LinkedinUrl  String?
  task3GithubUrl    String?
  task3LinkedinUrl  String?
  task4GithubUrl    String?
  task4LinkedinUrl  String?

  // Payment
  paymentStatus  PaymentStatus @default(PENDING)
  paymentAmount  Int           @default(12900) // ₹129 in paise
  paymentId      String?
  paymentOrderId String?
  paidAt         DateTime?

  // Eligibility
  tasksCompleted   Int     @default(0)  // counted by admin/system
  eligibleForLor   Boolean @default(false) // true if 4+ tasks
  eligibleForCert  Boolean @default(false) // true if 2+ tasks

  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
  @@index([paymentStatus])
  @@map("task_submissions")
}

// ─── Email Logs ───────────────────────────────────────────────────────────────
model EmailLog {
  id               String      @id @default(uuid())
  recipientEmail   String
  templateName     String
  subject          String?
  status           EmailStatus @default(QUEUED)
  sendgridMessageId String?
  errorMessage     String?
  metadata         Json?
  sentAt           DateTime?
  createdAt        DateTime    @default(now())

  @@index([recipientEmail])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  resolvedContacts ContactSubmission[]

  @@index([email])
  @@map("admin_users")
}

// ─── Contact Submissions ──────────────────────────────────────────────────────
model ContactSubmission {
  id         String    @id @default(uuid())
  fullName   String
  email      String
  phone      String?
  message    String
  isResolved Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  resolver AdminUser? @relation(fields: [resolvedBy], references: [id])

  @@index([isResolved])
  @@index([createdAt(sort: Desc)])
  @@map("contact_submissions")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum BatchStatus {
  OPEN
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ApplicationStatus {
  SUBMITTED
  PAYMENT_PENDING
  ENROLLED
  COMPLETED
  WITHDRAWN
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}